{
    "name": "scv",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "build": "run-s bundle lint",
        "build:searchIndex": "node ./scripts/build-searchIndex.ts",
        "build:vite": "vite build",
        "bundle": "run-s build:searchIndex build:vite",
        "check": "run-p typecheck lint format:check test",
        "dev": "vite",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --max-warnings 0",
        "lint:fix": "oxlint --max-warnings 0 --fix",
        "preview": "run-s build serve",
        "serve": "serve --no-clipboard -p 3081 dist/client",
        "test": "node --test",
        "typecheck": "tsc",
        "watch-preview": "onchange -k \"**/*.tsx\" -- pnpm preview"
    },
    "dependencies": {
        "@iconify/json": "2.2.533",
        "@sentry/react": "8.55.2",
        "@svgr/core": "8.1.0",
        "@svgr/plugin-jsx": "8.1.0",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "6.1.1",
        "autoprefixer": "10.6.1",
        "clsx": "2.1.1",
        "cross-env": "7.0.3",
        "mermaid": "11.17.2",
        "onchange": "7.1.0",
        "postcss": "8.5.28",
        "react": "18.3.1",
        "react-compiler-runtime": "1.0.0",
        "react-dom": "18.3.1",
        "react-select": "5.10.2",
        "react-virtuoso": "4.18.15",
        "react-zoom-pan-pinch": "3.7.0",
        "serve": "14.2.6",
        "tailwind-override": "0.6.1",
        "tailwindcss": "3.4.11",
        "unplugin-auto-import": "21.1.0",
        "unplugin-icons": "0.19.3",
        "vike": "0.4.266",
        "vite": "8.3.1"
    },
    "devDependencies": {
        "@tsconfig/strictest": "2.0.8",
        "@types/node": "24.13.6",
        "npm-run-all2": "9.0.3",
        "oxc-transform-react": "0.145.0",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "oxlint-config-presets": "0.1.20",
        "oxlint-tsgolint": "7.0.2003",
        "typescript": "5.9.3"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.28.1",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.x",
            "onFail": "download"
        }
    },
    "engines": {
        "node": "24.x",
        "pnpm": "11.x"
    },
    "packageManager": "pnpm@11.28.1"
}
